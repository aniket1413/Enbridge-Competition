# Path directly to WindFarmA folder
FARM_PATH = Path(r"C:\Users\anees\Downloads\WindFarmA")
OUTPUT_DIR = Path(r"C:\Users\anees\Downloads\ENBRIDGE X DSMLC")

def load_all_data():
    """Load all CSV files from WindFarmA"""
    all_data = {}

    if not FARM_PATH.exists():
        print(f"[ERR] Folder not found: {FARM_PATH}")
        return all_data

    csv_files = list(FARM_PATH.glob('*.csv'))
    print(f"Found {len(csv_files)} CSV files in WindFarmA...")

    for file in csv_files:
        try:
            df = pd.read_csv(file, sep=';', engine='python', nrows=1000)

            # Drop timestamp-like object columns
            df = df.drop(columns=[col for col in df.columns
                                   if df[col].dtype == 'object' and 'time' in col.lower()],
                         errors='ignore')

            # Convert to numeric float32 where possible
            for col in df.columns:
                if df[col].dtype != 'object':
                    try:
                        df[col] = pd.to_numeric(df[col], errors='coerce').astype(np.float32)
                    except:
                        pass

            # Drop columns that are entirely NaN
            df = df.dropna(axis=1, how='all')

            turbine_name = file.stem
            all_data[turbine_name] = df
            print(f"  [OK] Loaded {turbine_name}: {df.shape[0]} rows x {df.shape[1]} cols "
                  f"({df.memory_usage(deep=True).sum() / (1024**2):.1f} MB)")
        except Exception as e:
            print(f"  [ERR] Error loading {file.stem}: {str(e)[:80]}")

    print(f"\n{'='*60}")
    print(f"Total turbines loaded: {len(all_data)}")
    if all_data:
        total_memory = sum(df.memory_usage(deep=True).sum() for df in all_data.values()) / (1024**2)
        print(f"Total memory usage: {total_memory:.1f} MB")
    print(f"{'='*60}\n")
    return all_data


def detect_anomalies(data):
    """Detect anomalies using Isolation Forest"""
    numeric_cols = data.select_dtypes(include=[np.number]).columns

    if len(numeric_cols) > 100:
        from sklearn.decomposition import PCA
        X = data[numeric_cols].fillna(data[numeric_cols].mean()).astype(np.float32)
        print(f"    Reducing {len(numeric_cols)} features using PCA...")
        pca = PCA(n_components=min(50, len(numeric_cols) // 2))
        X_scaled = pca.fit_transform(X)
        print(f"    Reduced to {X_scaled.shape[1]} components "
              f"({pca.explained_variance_ratio_.sum()*100:.1f}% variance explained)")
    else:
        X = data[numeric_cols].fillna(data[numeric_cols].mean()).astype(np.float32)
        scaler = StandardScaler()
        X_scaled = scaler.fit_transform(X)

    iso_forest = IsolationForest(contamination=0.05, random_state=42, n_jobs=-1)
    anomalies = iso_forest.fit_predict(X_scaled)

    data = data.copy()
    data['anomaly'] = anomalies
    data['is_anomaly'] = data['anomaly'] == -1
    return data


def detect_statistical_anomalies(data, threshold=3):
    """Detect anomalies using Z-score method"""
    numeric_cols = data.select_dtypes(include=[np.number]).columns
    X = data[numeric_cols].fillna(data[numeric_cols].mean())
    z_scores = np.abs((X - X.mean()) / X.std())
    data = data.copy()
    data['z_anomaly'] = (z_scores > threshold).any(axis=1)
    return data


def analyze_turbine(turbine_name, df, turbine_count=1, total_turbines=1):
    """Analyze a single turbine for anomalies"""
    print(f"  [{turbine_count}/{total_turbines}] Analyzing {turbine_name}...", end=' ')

    df = detect_anomalies(df)
    df = detect_statistical_anomalies(df)

    num_anomalies_iso = df['is_anomaly'].sum()
    num_anomalies_z = df['z_anomaly'].sum()

    print(f"[OK] Found {num_anomalies_iso} anomalies (IF) | {num_anomalies_z} (Z-Score)")

    return {
        'turbine': turbine_name,
        'total_records': len(df),
        'iso_forest_anomalies': num_anomalies_iso,
        'z_score_anomalies': num_anomalies_z,
        'iso_forest_pct': (num_anomalies_iso / len(df) * 100) if len(df) > 0 else 0,
        'z_score_pct': (num_anomalies_z / len(df) * 100) if len(df) > 0 else 0,
        'data': df
    }


def create_visualizations(all_data):
    """Create comprehensive visualizations of anomalies"""

    anomaly_summary = []
    turbine_data_with_anomalies = {}

    print("\nDetecting anomalies in all turbines...")
    total = len(all_data)
    for idx, (turbine_name, df) in enumerate(all_data.items(), 1):
        summary = analyze_turbine(turbine_name, df, turbine_count=idx, total_turbines=total)
        anomaly_summary.append(summary)
        turbine_data_with_anomalies[turbine_name] = summary['data']

    anomaly_df = pd.DataFrame([
        {
            'Turbine': s['turbine'],
            'Total Records': s['total_records'],
            'Isolation Forest Anomalies': s['iso_forest_anomalies'],
            'Z-Score Anomalies': s['z_score_anomalies'],
            'IF % Anomalous': s['iso_forest_pct'],
            'Z-Score % Anomalous': s['z_score_pct']
        }
        for s in anomaly_summary
    ])

    print("\n" + "="*80)
    print("ANOMALY DETECTION SUMMARY - WindFarmA")
    print("="*80)
    print(anomaly_df.to_string(index=False))
    print("="*80)

    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

    # --- Plot 1: Overview (4 subplots) ---
    fig, axes = plt.subplots(2, 2, figsize=(16, 12))
    fig.suptitle('WindFarmA - Anomaly Detection Overview', fontsize=15, fontweight='bold')

    ax1 = axes[0, 0]
    sorted_df = anomaly_df.sort_values('Isolation Forest Anomalies', ascending=False).head(20)
    ax1.barh(sorted_df['Turbine'], sorted_df['Isolation Forest Anomalies'], color='coral')
    ax1.set_xlabel('Number of Anomalies (Isolation Forest)', fontsize=11, fontweight='bold')
    ax1.set_title('Top Turbines by Anomaly Count', fontsize=12, fontweight='bold')
    ax1.grid(axis='x', alpha=0.3)

    ax2 = axes[0, 1]
    sorted_pct = anomaly_df.sort_values('IF % Anomalous', ascending=False).head(20)
    ax2.barh(sorted_pct['Turbine'], sorted_pct['IF % Anomalous'], color='skyblue')
    ax2.set_xlabel('Percentage Anomalous (%)', fontsize=11, fontweight='bold')
    ax2.set_title('Top Turbines by Anomaly Percentage', fontsize=12, fontweight='bold')
    ax2.grid(axis='x', alpha=0.3)

    ax3 = axes[1, 0]
    x_pos = np.arange(min(15, len(anomaly_df)))
    width = 0.35
    ax3.bar(x_pos - width/2, anomaly_df['Isolation Forest Anomalies'].head(15),
            width, label='Isolation Forest', color='coral', alpha=0.8)
    ax3.bar(x_pos + width/2, anomaly_df['Z-Score Anomalies'].head(15),
            width, label='Z-Score', color='lightgreen', alpha=0.8)
    ax3.set_xlabel('Turbine', fontsize=11, fontweight='bold')
    ax3.set_ylabel('Number of Anomalies', fontsize=11, fontweight='bold')
    ax3.set_title('Detection Method Comparison', fontsize=12, fontweight='bold')
    ax3.set_xticks(x_pos)
    ax3.set_xticklabels(anomaly_df['Turbine'].head(15), rotation=90, fontsize=8)
    ax3.legend()
    ax3.grid(axis='y', alpha=0.3)

    ax4 = axes[1, 1]
    methods = ['Isolation Forest', 'Z-Score']
    avg_anomalies = [anomaly_df['Isolation Forest Anomalies'].mean(),
                     anomaly_df['Z-Score Anomalies'].mean()]
    bars = ax4.bar(methods, avg_anomalies, color=['coral', 'lightgreen'],
                   alpha=0.8, edgecolor='black', linewidth=2)
    ax4.set_ylabel('Average Anomalies per Turbine', fontsize=11, fontweight='bold')
    ax4.set_title('Average Anomalies by Detection Method', fontsize=12, fontweight='bold')
    ax4.grid(axis='y', alpha=0.3)
    for bar in bars:
        height = bar.get_height()
        ax4.text(bar.get_x() + bar.get_width()/2., height,
                 f'{height:.1f}', ha='center', va='bottom', fontweight='bold')

    plt.tight_layout()
    plt.savefig(OUTPUT_DIR / 'anomaly_overview.png', dpi=300, bbox_inches='tight')
    print("\n[OK] Saved: anomaly_overview.png")
    plt.show()

    # --- Plot 2: Time series for top 4 most anomalous turbines ---
    top_anomalous = anomaly_df.nlargest(4, 'Isolation Forest Anomalies')['Turbine'].values

    fig, axes = plt.subplots(2, 2, figsize=(18, 12))
    fig.suptitle('WindFarmA - Top 4 Anomalous Turbines (Time Series)', fontsize=15, fontweight='bold')
    axes = axes.flatten()

    for idx, turbine in enumerate(top_anomalous):
        if turbine in turbine_data_with_anomalies:
            df = turbine_data_with_anomalies[turbine]

            power_cols = [col for col in df.columns if 'power' in col.lower() and 'avg' in col.lower()]
            power_col = power_cols[0] if power_cols else df.select_dtypes(include=[np.number]).columns[0]

            ax = axes[idx]
            normal_mask = ~df['is_anomaly']
            anomaly_mask = df['is_anomaly']

            ax.plot(df.index[normal_mask], df[power_col][normal_mask],
                    'o-', label='Normal', color='green', markersize=3, linewidth=1.5, alpha=0.7)
            ax.scatter(df.index[anomaly_mask], df[power_col][anomaly_mask],
                       label='Anomaly', color='red', s=100, marker='X', zorder=5)

            ax.set_xlabel('Time Index', fontsize=10, fontweight='bold')
            ax.set_ylabel(power_col, fontsize=10, fontweight='bold')
            ax.set_title(f'{turbine} - {anomaly_mask.sum()} Anomalies', fontsize=11, fontweight='bold')
            ax.legend(loc='best')
            ax.grid(alpha=0.3)

    plt.tight_layout()
    plt.savefig(OUTPUT_DIR / 'anomaly_timeseries.png', dpi=300, bbox_inches='tight')
    print("[OK] Saved: anomaly_timeseries.png")
    plt.show()

    # --- Plot 3: Scatter plot of IF anomaly % vs Z-Score % ---
    fig, ax = plt.subplots(figsize=(10, 7))
    scatter = ax.scatter(anomaly_df['IF % Anomalous'], anomaly_df['Z-Score % Anomalous'],
                         c=anomaly_df['Isolation Forest Anomalies'], cmap='YlOrRd',
                         s=100, edgecolors='black', linewidth=0.5, zorder=3)
    plt.colorbar(scatter, ax=ax, label='IF Anomaly Count')
    for _, row in anomaly_df.iterrows():
        ax.annotate(row['Turbine'], (row['IF % Anomalous'], row['Z-Score % Anomalous']),
                    fontsize=7, ha='left', va='bottom', alpha=0.7)
    ax.set_xlabel('Isolation Forest Anomaly %', fontsize=12, fontweight='bold')
    ax.set_ylabel('Z-Score Anomaly %', fontsize=12, fontweight='bold')
    ax.set_title('WindFarmA - IF vs Z-Score Anomaly Rate per Turbine', fontsize=13, fontweight='bold')
    ax.grid(alpha=0.3)
    plt.tight_layout()
    plt.savefig(OUTPUT_DIR / 'anomaly_scatter.png', dpi=300, bbox_inches='tight')
    print("[OK] Saved: anomaly_scatter.png")
    plt.show()

    # Export results
    anomaly_df.to_csv(OUTPUT_DIR / 'anomaly_summary.csv', index=False)
    print("[OK] Saved: anomaly_summary.csv")

    return anomaly_df, turbine_data_with_anomalies


def main():
    print("Starting Anomaly Detection Analysis - WindFarmA")
    print("-" * 80)

    all_data = load_all_data()

    if not all_data:
        print("Error: No data loaded. Please check that the folder exists:")
        print(f"  {FARM_PATH}")
        return

    anomaly_results, turbine_data = create_visualizations(all_data)

    print("\n" + "="*80)
    print("ANALYSIS COMPLETE")
    print("="*80)
    print(f"Total turbines analyzed: {len(anomaly_results)}")
    print(f"Total anomalies (Isolation Forest): {anomaly_results['Isolation Forest Anomalies'].sum()}")
    print(f"Total anomalies (Z-Score):          {anomaly_results['Z-Score Anomalies'].sum()}")
    print(f"\nOutputs saved to: {OUTPUT_DIR}")
    print("="*80)


if __name__ == "__main__":
    main()
