def load_data(file_path, nrows=None):
    """Load a single CSV file with proper handling"""
    try:
        # Read with proper separator and data types
        df = pd.read_csv(file_path, sep=';', engine='python', nrows=nrows)
        
        # Handle first column if it's datetime
        first_col = df.columns[0]
        if first_col and df[first_col].dtype == 'object':
            try:
                # Try to parse as datetime
                df[first_col] = pd.to_datetime(df[first_col], errors='ignore')
                # Set as index if it's a datetime column
                if pd.api.types.is_datetime64_any_dtype(df[first_col]):
                    df.set_index(first_col, inplace=True)
            except:
                pass
        
        # Convert all remaining columns to numeric, coercing errors to NaN
        numeric_cols = df.select_dtypes(include=['object']).columns
        for col in numeric_cols:
            df[col] = pd.to_numeric(df[col], errors='coerce')
        
        # Convert to float32 to save memory
        float_cols = df.select_dtypes(include=[np.number]).columns
        for col in float_cols:
            df[col] = df[col].astype(np.float32)
        
        # Drop columns that are entirely NaN
        df = df.dropna(axis=1, how='all')
        
        # Drop rows that are entirely NaN
        df = df.dropna(how='all')
        
        return df
    except Exception as e:
        print(f"  [ERR] Failed to load: {str(e)[:100]}")
        return None

def detect_anomalies_isolation_forest(X_scaled):
    """Detect anomalies using Isolation Forest"""
    iso_forest = IsolationForest(contamination=0.05, random_state=42, n_jobs=-1)
    anomalies = iso_forest.fit_predict(X_scaled)
    return anomalies == -1

def detect_anomalies_zscore(X, threshold=3):
    """Detect anomalies using Z-score method"""
    z_scores = np.abs((X - X.mean()) / X.std())
    return (z_scores > threshold).any(axis=1)

def analyze_turbine(turbine_name, df):
    """Analyze a single turbine for anomalies"""
    try:
        # Get numeric columns only
        numeric_cols = df.select_dtypes(include=[np.number]).columns
        if len(numeric_cols) == 0:
            print(f"    [SKIP] {turbine_name}: No numeric columns")
            return None
        
        X = df[numeric_cols].copy()
        
        # Fill NaN values
        X = X.fillna(X.mean())
        
        # Handle case where all values are NaN
        if X.isna().all().any():
            print(f"    [SKIP] {turbine_name}: All NaN columns")
            return None
        
        # Standardize features
        scaler = StandardScaler()
        X_scaled = scaler.fit_transform(X)
        
        # Apply dimensionality reduction if needed (too many features)
        if X_scaled.shape[1] > 100:
            pca = PCA(n_components=min(50, X_scaled.shape[1]//2))
            X_scaled = pca.fit_transform(X_scaled)
        
        # Detect anomalies
        anomalies_if = detect_anomalies_isolation_forest(X_scaled)
        anomalies_z = detect_anomalies_zscore(X)
        
        num_anomalies_if = anomalies_if.sum()
        num_anomalies_z = anomalies_z.sum()
        
        result = {
            'turbine': turbine_name,
            'total_records': len(df),
            'num_features': len(numeric_cols),
            'iso_forest_anomalies': num_anomalies_if,
            'z_score_anomalies': num_anomalies_z,
            'iso_forest_pct': (num_anomalies_if / len(df) * 100),
            'z_score_pct': (num_anomalies_z / len(df) * 100),
            'df': df,
            'anomalies_if': anomalies_if,
            'anomalies_z': anomalies_z,
            'numeric_cols': numeric_cols.tolist()
        }
        
        print(f"    ✓ {turbine_name}: {num_anomalies_if} IF anomalies, {num_anomalies_z} Z-score anomalies")
        return result
    except Exception as e:
        print(f"    [ERR] {turbine_name}: {str(e)[:80]}")
        return None

def main():
    print("="*70)
    print("WINDFARMB ANOMALY DETECTION ANALYSIS")
